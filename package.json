{
  "name": "@nejcm/dev-toolbar",
  "version": "0.1.0",
  "private": false,
  "description": "Extensible, low-overhead in-app developer toolbar for React applications: runtime health signals, feature flags, overlays and diagnostics.",
  "keywords": [
    "react",
    "devtools",
    "developer-toolbar",
    "feature-flags",
    "performance",
    "diagnostics",
    "observability"
  ],
  "license": "MIT",
  "author": "nejcm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nejcm/dev-toolbar.git"
  },
  "bugs": {
    "url": "https://github.com/nejcm/dev-toolbar/issues"
  },
  "homepage": "https://github.com/nejcm/dev-toolbar#readme",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "require": "./dist/runtime.cjs"
    },
    "./ext/metrics": {
      "types": "./dist/ext/metrics.d.ts",
      "import": "./dist/ext/metrics.js",
      "require": "./dist/ext/metrics.cjs"
    },
    "./ext/environment": {
      "types": "./dist/ext/environment.d.ts",
      "import": "./dist/ext/environment.js",
      "require": "./dist/ext/environment.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "playground": "npm --prefix examples/playground run dev",
    "playground:install": "npm --prefix examples/playground install",
    "playground:build": "npm --prefix examples/playground run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:jest-consumer": "npm run build && npm --prefix test/fixtures/jest-consumer run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "@testing-library/react": ">=14"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
