{
  "name": "@nejcm/dev-toolbar",
  "version": "0.12.1",
  "private": false,
  "description": "Extensible, low-overhead in-app developer toolbar for React applications: runtime health signals, feature flags, overlays and diagnostics.",
  "keywords": [
    "react",
    "devtools",
    "developer-toolbar",
    "feature-flags",
    "performance",
    "diagnostics",
    "observability"
  ],
  "license": "MIT",
  "author": "nejcm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nejcm/dev-toolbar.git"
  },
  "bugs": {
    "url": "https://github.com/nejcm/dev-toolbar/issues"
  },
  "homepage": "https://nejcm.github.io/dev-toolbar/",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      },
      "require": {
        "types": "./dist/runtime.d.cts",
        "default": "./dist/runtime.cjs"
      }
    },
    "./kit": {
      "import": {
        "types": "./dist/kit.d.ts",
        "default": "./dist/kit.js"
      },
      "require": {
        "types": "./dist/kit.d.cts",
        "default": "./dist/kit.cjs"
      }
    },
    "./ext/a11y": {
      "import": {
        "types": "./dist/ext/a11y.d.ts",
        "default": "./dist/ext/a11y.js"
      },
      "require": {
        "types": "./dist/ext/a11y.d.cts",
        "default": "./dist/ext/a11y.cjs"
      }
    },
    "./ext/agent": {
      "import": {
        "types": "./dist/ext/agent.d.ts",
        "default": "./dist/ext/agent.js"
      },
      "require": {
        "types": "./dist/ext/agent.d.cts",
        "default": "./dist/ext/agent.cjs"
      }
    },
    "./ext/metrics": {
      "import": {
        "types": "./dist/ext/metrics.d.ts",
        "default": "./dist/ext/metrics.js"
      },
      "require": {
        "types": "./dist/ext/metrics.d.cts",
        "default": "./dist/ext/metrics.cjs"
      }
    },
    "./ext/environment": {
      "import": {
        "types": "./dist/ext/environment.d.ts",
        "default": "./dist/ext/environment.js"
      },
      "require": {
        "types": "./dist/ext/environment.d.cts",
        "default": "./dist/ext/environment.cjs"
      }
    },
    "./ext/command-menu": {
      "import": {
        "types": "./dist/ext/command-menu.d.ts",
        "default": "./dist/ext/command-menu.js"
      },
      "require": {
        "types": "./dist/ext/command-menu.d.cts",
        "default": "./dist/ext/command-menu.cjs"
      }
    },
    "./ext/overlays": {
      "import": {
        "types": "./dist/ext/overlays.d.ts",
        "default": "./dist/ext/overlays.js"
      },
      "require": {
        "types": "./dist/ext/overlays.d.cts",
        "default": "./dist/ext/overlays.cjs"
      }
    },
    "./ext/diagnostics": {
      "import": {
        "types": "./dist/ext/diagnostics.d.ts",
        "default": "./dist/ext/diagnostics.js"
      },
      "require": {
        "types": "./dist/ext/diagnostics.d.cts",
        "default": "./dist/ext/diagnostics.cjs"
      }
    },
    "./ext/flags": {
      "import": {
        "types": "./dist/ext/flags.d.ts",
        "default": "./dist/ext/flags.js"
      },
      "require": {
        "types": "./dist/ext/flags.d.cts",
        "default": "./dist/ext/flags.cjs"
      }
    },
    "./ext/theme-editor": {
      "import": {
        "types": "./dist/ext/theme-editor.d.ts",
        "default": "./dist/ext/theme-editor.js"
      },
      "require": {
        "types": "./dist/ext/theme-editor.d.cts",
        "default": "./dist/ext/theme-editor.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "docs": "bun run docs:dev",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "playground": "cd examples/playground && bun run dev",
    "playground:install": "rm -rf examples/playground/node_modules/@nejcm && cd examples/playground && bun install",
    "playground:build": "cd examples/playground && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:jest-consumer": "bun run build && bun run --cwd test/fixtures/jest-consumer test",
    "test:vite-consumer": "bun run build && bun run --cwd test/fixtures/vite-consumer test",
    "test:e2e": "bun run build && bun run --cwd examples/playground test:e2e",
    "lint": "oxlint --max-warnings=0",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip --no-config-hints",
    "check:package": "publint && attw --pack . --profile node16 --exclude-entrypoints ./styles.css",
    "size": "bun run build && node scripts/bundle-size.mjs",
    "verify:static": "bun run format:check && bun run typecheck && bun run lint && bun run knip && bun run build && bun run check:package",
    "verify": "bun run verify:static && bun run test",
    "verify:docs": "bun run docs:build",
    "prepublishOnly": "bun run typecheck && bun run build",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged",
    "commit-msg": "bunx commitlint --edit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "@testing-library/react": ">=14",
    "axe-core": ">=4.8"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.81.0",
    "publint": "^0.3.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simple-git-hooks": "^2.14.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitepress": "~1.6.4",
    "vitest": "^4.1.11"
  },
  "peerDependenciesMeta": {
    "@testing-library/react": {
      "optional": true
    },
    "axe-core": {
      "optional": true
    }
  },
  "packageManager": "bun@1.4.0"
}
