{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "endOfLine": "lf",
  "printWidth": 100,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "coverage",
    "plans",
    "examples/playground",
    "test/fixtures",
    "src/styles.css",
    "**/*.md",
    "**/*.json"
  ]
}
