{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts",
    "src/runtime/index.ts",
    "src/kit/index.ts",
    "src/ext/*/index.tsx",
    "src/testing/index.ts",
    "src/**/*.test.{ts,tsx}",
    "scripts/*.mjs"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs"],
  "vitepress": {
    "entry": ["docs/.vitepress/config.ts", "docs/.vitepress/theme/index.ts"]
  }
}
