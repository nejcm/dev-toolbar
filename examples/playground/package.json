{
  "name": "@nejcm/dev-toolbar-playground",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Unpublished manual-verification app for @nejcm/dev-toolbar. Not part of the package's `files`.",
  "scripts": {
    "predev": "cd ../.. && bun run build",
    "dev": "vite",
    "prebuild": "cd ../.. && bun run build",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test plugins/__tests__/devToolbarAgent.test.ts",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@nejcm/dev-toolbar": "file:../..",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tanstack/devtools-client": "^0.0.8",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=24"
  }
}
